<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BeeX DeskNest</AssemblyName>
    <RootNamespace>BeeX.DeskNest</RootNamespace>
    <ApplicationIcon>Assets\BeeX.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en;zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BeeX.DeskNest.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\BeeX.png" />
    <Resource Include="Assets\BeeX.ico" />
    <Resource Include="Assets\Icons\*.svg" />
    <Resource Include="Write\Assets\branding\BeeX.ico" />
    <Resource Include="Write\Assets\branding\BeeX.png" />
    <Resource Include="Write\Assets\icons\tabler\**\*.svg" />
    <!-- ffmpeg 不再內置：改由 FfmpegInstallerService 按需下載到 %LocalAppData%\BeeX\DeskNest\ffmpeg -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>
  <!-- OCR\ 是独立的侧车项目（BeeX_OCR.csproj，net8 + Paddle 运行时），
       单独构建发布为 beex-ocr 安装包，绝不能编进 DeskNest 主 exe（体积+oneDNN 互斥） -->
  <ItemGroup>
    <Compile Remove="OCR\**" />
    <Page Remove="OCR\**" />
    <ApplicationDefinition Remove="OCR\**" />
    <Resource Remove="OCR\**" />
    <EmbeddedResource Remove="OCR\**" />
    <Content Remove="OCR\**" />
    <None Remove="OCR\**" />
  </ItemGroup>
  <!-- BeexWrite web editor bundle: embedded into the exe and
       self-extracted at runtime to %LocalAppData%\BeeX\DeskNest\wwwroot by WriteHost. -->
  <ItemGroup>
    <None Remove="Write\wwwroot\**" />
    <EmbeddedResource Include="Write\wwwroot\**">
      <LogicalName>BeeX.DeskNest.wwwroot.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
