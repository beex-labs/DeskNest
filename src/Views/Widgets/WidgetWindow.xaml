<Window x:Class="BeeX.DeskNest.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" MinWidth="260" MinHeight="220" AllowDrop="True" Drop="Window_Drop">
 <Border x:Name="RootBorder" Background="#F2FFFFFF" BorderBrush="#40FF8A00" BorderThickness="1" CornerRadius="18" Padding="1"><Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity=".18" Color="#0D1321"/></Border.Effect>
  <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/></Grid.RowDefinitions>
   <Border x:Name="HeaderBorder" CornerRadius="16,16,0,0" Background="#EFFFFFFF" MouseLeftButtonDown="Header_Drag"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="LogoBox" Width="30" Height="30" CornerRadius="8" MouseLeftButtonDown="Logo_DoubleClick"><Image Source="pack://application:,,,/Assets/BeeX.png"/></Border><TextBox x:Name="TitleBox" Grid.Column="1" FontWeight="SemiBold" FontSize="15" Background="Transparent" BorderThickness="0" Padding="4" VerticalContentAlignment="Center" LostFocus="Title_Changed"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="CollapseButton" Content="⌃" Padding="10,6" Click="Collapse_Click" ToolTip="摺疊/展開"/><Button x:Name="SettingsBtn" Content="⚙" Padding="10,6" Click="Settings_Click" ToolTip="皮膚與透明度"/><Button x:Name="HideBtn" Content="—" Padding="10,6" Click="Hide_Click" ToolTip="隱藏到系統匣"/></StackPanel></Grid></Border>
   <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><Grid x:Name="ContentHost" Margin="14,10,14,14">
    <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontSize="14" TextChanged="Note_Changed"/>
    <Grid x:Name="TodoPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid x:Name="TodoInputRow" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TodoInput" Height="42" Padding="10,6" VerticalContentAlignment="Center" KeyDown="TodoInput_KeyDown" ToolTip="添加任務"/><Button x:Name="AddTodoButton" Grid.Column="1" Width="46" Height="42" Padding="0" Content="＋" Background="#FF8A00" Foreground="White" Click="AddTodo_Click"/></Grid><UniformGrid Grid.Row="1" Columns="4" Margin="0,7,0,4"><Button x:Name="TodoAllTab" Content="全部 0" Tag="All" Click="TodoFilter_Click"/><Button x:Name="TodoTodayTab" Content="今天 0" Tag="Today" Click="TodoFilter_Click"/><Button x:Name="TodoImportantTab" Content="重要 0" Tag="Important" Click="TodoFilter_Click"/><Button x:Name="TodoDoneTab" Content="已完成 0" Tag="Done" Click="TodoFilter_Click"/></UniformGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,5"><Button Width="24" Height="24" Padding="0" Background="#D92D20" Tag="#D92D20" Click="TodoColor_Click"/><Button Width="24" Height="24" Padding="0" Background="#F79009" Tag="#F79009" Click="TodoColor_Click"/><Button Width="24" Height="24" Padding="0" Background="#FEC84B" Tag="#FEC84B" Click="TodoColor_Click"/><Button Width="24" Height="24" Padding="0" Background="#12B76A" Tag="#12B76A" Click="TodoColor_Click"/><Button Width="24" Height="24" Padding="0" Background="#2E90FA" Tag="#2E90FA" Click="TodoColor_Click"/><Button Width="24" Height="24" Padding="0" Background="#7F56D9" Tag="#7F56D9" Click="TodoColor_Click"/><Button Width="24" Height="24" Padding="0" Background="#EE46BC" Tag="#EE46BC" Click="TodoColor_Click"/><Button Width="24" Height="24" Padding="0" Background="#667085" Tag="#667085" Click="TodoColor_Click"/></StackPanel><ListBox Grid.Row="3" x:Name="TodoList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Resources><Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#0D1321"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="cb" Width="20" Height="20" CornerRadius="6" Background="#CFFFFFFF" BorderBrush="#9AFFFFFF" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="cm" Data="M5,10 L8,13 L15,6" Stroke="#FF8A00" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="12" Height="10" Stretch="Uniform"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="cm" Property="Visibility" Value="Visible"/><Setter TargetName="cb" Property="Background" Value="#FF8A00"/><Setter TargetName="cb" Property="BorderBrush" Value="White"/><Setter TargetName="cb" Property="BorderThickness" Value="1.5"/><Setter TargetName="cm" Property="Stroke" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="BorderBrush" Value="#FF8A00"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.Resources><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,4"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,7,0,0"/><StackPanel Grid.Column="1" Margin="3,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox VerticalAlignment="Center" IsChecked="{Binding Done, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="Todo_Changed" Unchecked="Todo_Changed"/><TextBlock Grid.Column="1" Text="{Binding Text}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/><Button Grid.Column="2" Click="SubExpandToggle_Click" Background="Transparent" BorderThickness="0" Padding="6,0" Cursor="Hand" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"><Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding SubItems.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SubSummary}" FontSize="11" Opacity="0.72" VerticalAlignment="Center"/><TextBlock FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#x25B8;"/><Style.Triggers><DataTrigger Binding="{Binding SubExpanded}" Value="True"><Setter Property="Text" Value="&#x25BE;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button></Grid><TextBlock Text="{Binding DeadlineCountdown}" FontSize="10" Margin="22,1,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FF8A00"/><Style.Triggers><DataTrigger Binding="{Binding DeadlineCountdown}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ItemsControl ItemsSource="{Binding SubItems}" Margin="20,3,0,2"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding SubExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SubItems.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Text}" FontSize="12" Margin="0,1,0,1" VerticalContentAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" IsChecked="{Binding Done, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="Subtodo_Changed" Unchecked="Subtodo_Changed"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Grid.Row="4" Margin="4,6,4,0"><TextBlock x:Name="TodoRemaining" Text="剩餘 0 項" Foreground="#667085" VerticalAlignment="Center"/><Button x:Name="ClearCompletedButton" Content="清除已完成" HorizontalAlignment="Right" Click="ClearCompleted_Click"/></Grid></Grid>
    <Grid x:Name="FolderPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="DropHint" Text="拖放檔案到這裡收納" Foreground="#FF8A00" Margin="4" Visibility="Collapsed"/><ListBox Grid.Row="1" x:Name="FileList" MouseDoubleClick="File_DoubleClick" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Margin="{Binding Margin}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontSize="{Binding IconSize}" Foreground="{Binding Foreground}" Margin="0,0,8,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{Binding DetailForeground}" FontSize="11"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="在檔案總管中開啟" Click="OpenFolder_Click"/></Grid>
    <Grid x:Name="CapturePanel" Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><UniformGrid Columns="5" Margin="0,0,0,7"><Button Content="＋文字" Height="36" Padding="2,0" FontSize="13" Background="#FFF3E5" Foreground="#0D1321" Click="NewCapture_Click"/><Button Content="圖片" Height="36" Padding="2,0" FontSize="13" Background="#FFF3E5" Foreground="#0D1321" Click="AddImage_Click"/><Button Content="固定" Height="36" Padding="2,0" FontSize="13" Background="#FFF3E5" Foreground="#0D1321" Click="PinCapture_Click"/><Button Content="刪除" Height="36" Padding="2,0" FontSize="13" Background="#FFF3E5" Foreground="#0D1321" Click="DeleteCapture_Click"/><Button Content="清除全部" Height="36" Padding="2,0" FontSize="13" Background="#FFF3E5" Foreground="#0D1321" Click="ClearCapture_Click"/></UniformGrid><UniformGrid Grid.Row="1" Columns="3"><Button x:Name="CaptureAllTab" Content="全部" Tag="All" Click="CaptureFilter_Click"/><Button x:Name="CaptureClipboardTab" Content="剪貼板" Tag="Clipboard" Click="CaptureFilter_Click"/><Button x:Name="CaptureManualTab" Content="我的隨記" Tag="Manual" Click="CaptureFilter_Click"/></UniformGrid></Grid>
      <ListBox Grid.Row="1" x:Name="CaptureList" MouseDoubleClick="Capture_DoubleClick" BorderThickness="0" Background="Transparent" SelectionMode="Extended" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2,0,2"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CaptureSelection" Background="{TemplateBinding Background}" CornerRadius="15" ClipToBounds="True" Padding="2"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CaptureSelection" Property="Background" Value="#FF8A00"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="CaptureSelection" Property="Background" Value="#50FF8A00"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="{Binding Paper}" CornerRadius="13" ClipToBounds="True" Padding="9" HorizontalAlignment="Stretch" SnapsToDevicePixels="True">
              <StackPanel>
                <Image Source="{Binding Image}" MaxHeight="130" Stretch="Uniform" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor}" TextWrapping="Wrap" MaxHeight="120"/>
                <Border Background="#50FFF3E5" CornerRadius="8" Padding="7,3" Margin="0,5,0,2" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Badge}" Foreground="#FF8A00" FontSize="10" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="{Binding Time}" Foreground="#98A0AE" FontSize="10"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Visibility="Collapsed"><Button Content="新增文字" Click="NewCapture_Click"/><Button Content="添加圖片" Click="AddImage_Click"/><Button Content="固定" Click="PinCapture_Click"/><Button Content="刪除" Click="DeleteCapture_Click"/></StackPanel>
    </Grid>
    <Grid x:Name="MusicPanel" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><TextBlock Text="系統媒體控制" HorizontalAlignment="Center" Foreground="#6B7280" Margin="0,0,0,14"/><UniformGrid Columns="3"><Button Content="◀◀" FontSize="20" Click="Previous_Click"/><Button x:Name="PlayPauseButton" Content="▶" FontSize="20" Background="#FF8A00" Foreground="White" Click="PlayPause_Click"/><Button Content="▶▶" FontSize="20" Click="Next_Click"/></UniformGrid><UniformGrid Columns="3" Margin="0,10,0,0"><Button Content="音量 −" Click="VolumeDown_Click"/><Button Content="靜音" Click="Mute_Click"/><Button Content="音量 ＋" Click="VolumeUp_Click"/></UniformGrid></StackPanel></Grid>
    <Grid x:Name="ClockPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid x:Name="ClockCalendar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,6,0,8"/>
      <StackPanel x:Name="ClockStack" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center"><TextBlock x:Name="ClockTime" FontSize="48" FontWeight="Light" HorizontalAlignment="Center"/><TextBlock x:Name="ClockDate" FontSize="15" HorizontalAlignment="Center" Foreground="#6B7280" Margin="0,8"/><TextBlock x:Name="AlarmHeader" Text="即將提醒" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/><ListBox x:Name="AlarmList" MaxHeight="100" BorderThickness="0" Background="Transparent"/><Button Content="＋ 新增鬧鐘" Click="AddAlarm_Click" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
    </Grid>
    <Grid x:Name="ScreenshotPanel" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><Border Width="68" Height="68" CornerRadius="18" Background="#18FF8A00" HorizontalAlignment="Center"><Image Source="pack://application:,,,/Assets/BeeX.png" Margin="10"/></Border><TextBlock Text="區域截圖" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/><TextBlock Text="拖曳選取範圍 · Esc 取消" Foreground="#6B7280" HorizontalAlignment="Center"/><Button Content="開始截圖    Ctrl + Alt + A" Click="Screenshot_Click" Background="#FF8A00" Foreground="White" Margin="4,18,4,5"/><Button Content="開啟截圖資料夾" Click="OpenCaptures_Click"/></StackPanel></Grid>
     <Grid x:Name="WeatherPanel" Visibility="Collapsed"><Grid x:Name="WeatherLayout" VerticalAlignment="Center" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><StackPanel x:Name="WeatherSummary" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBox x:Name="WeatherCity" Text="深圳" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" TextAlignment="Center" Background="Transparent" BorderThickness="0" Padding="4" FontWeight="SemiBold" IsReadOnly="True" Focusable="False" Cursor="Arrow"/><Image x:Name="WeatherIcon" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,5,0,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock x:Name="WeatherTemp" Text="--°" FontSize="38" FontWeight="Light" HorizontalAlignment="Stretch" TextAlignment="Center"/></StackPanel><StackPanel x:Name="WeatherExtra" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBlock x:Name="WeatherDetail" Text="正在載入天氣…" HorizontalAlignment="Stretch" TextAlignment="Center" Foreground="#6B7280" TextWrapping="Wrap"/><UniformGrid x:Name="WeatherForecastGrid" Columns="5" Margin="0,9,0,0"/><UniformGrid x:Name="WeatherMetricsGrid" Columns="2" Margin="0,8,0,0"/></StackPanel></Grid></Grid>
   </Grid></ScrollViewer>
  </Grid>
 </Border>
</Window>
