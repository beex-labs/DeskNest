<Window x:Class="BeeX.DeskNest.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BeeX DeskNest 設定" Width="920" Height="650" MinWidth="780" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#EAF1FA">
 <Grid Background="#EAF1FA"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#DDE9F6" Padding="18,24,18,18"><ListBox x:Name="Nav" SelectionChanged="Nav_Changed" Background="Transparent" BorderThickness="0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,3"/></Style></ListBox.ItemContainerStyle><ListBoxItem x:Name="NavGeneral" Tag="General"/><ListBoxItem x:Name="NavAppearance" Tag="Appearance"/><ListBoxItem x:Name="NavFiles" Tag="Files"/><ListBoxItem x:Name="NavFeatures" Tag="Features"/><ListBoxItem x:Name="NavTodo" Tag="Todo"/><ListBoxItem x:Name="NavCapture" Tag="Capture"/><ListBoxItem x:Name="NavCaptureRecord" Tag="CaptureRecord"/><ListBoxItem x:Name="NavMusic" Tag="Music"/><ListBoxItem x:Name="NavWeather" Tag="Weather"/><ListBoxItem x:Name="NavShortcuts" Tag="Shortcuts"/><ListBoxItem x:Name="NavCleaner" Tag="Cleaner"/><ListBoxItem x:Name="NavMaintenance" Tag="Maintenance"/><ListBoxItem x:Name="NavAbout" Tag="About"/></ListBox></Border>
  <Grid Grid.Column="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="PageTitle" Text="常規" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid>
   <StackPanel x:Name="GeneralPage"><TextBlock Text="BeeX 資料目錄" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="截圖、錄屏、便籤、收納、設定與元件全部保存在此資料夾。" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,8"/><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BeeXRootPathBox" IsReadOnly="True" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="更改位置…" Margin="8,0,0,0" Click="ChangeBeeXRoot_Click"/><Button Grid.Column="2" Content="打開資料夾" Margin="8,0,0,0" Click="OpenBeeXRoot_Click"/></Grid><TextBlock Text="語言" FontWeight="SemiBold"/><ComboBox x:Name="LanguageCombo" Margin="0,8,0,18" SelectionChanged="Language_Changed" SelectedValuePath="Code" DisplayMemberPath="Name"/><CheckBox x:Name="Startup" Content="開機自動啟動" Checked="Changed" Unchecked="Changed" Margin="0,8"/><TextBlock Text="關閉主視窗時程式繼續留在系統匣。" Foreground="#667085" Margin="0,8,0,18"/><CheckBox x:Name="ReminderSummary" Content="顯示提醒摘要" Checked="Changed" Unchecked="Changed" Margin="0,8"/><TextBlock Text="顯示待辦提醒詳情；Windows 鎖定時一律隱藏內容。" Foreground="#667085" TextWrapping="Wrap" Margin="0,2,0,16"/><TextBlock Text="摺疊顯示" FontWeight="SemiBold" Margin="0,8,0,4"/><CheckBox x:Name="CollapsedLogo" Content="摺疊後顯示 BeeX Logo" Checked="Changed" Unchecked="Changed" Margin="0,8"/><TextBlock Text="懸浮球" FontWeight="SemiBold" Margin="0,8,0,4"/><CheckBox x:Name="FloatingBallEnabled" Content="顯示 BeeX 懸浮球" Checked="Changed" Unchecked="Changed" Margin="0,8"/><CheckBox x:Name="FloatingBallSnap" Content="拖動後自動吸附螢幕邊緣" Checked="Changed" Unchecked="Changed" Margin="0,8"/><TextBlock Text="懸浮球透明度"/><Slider x:Name="FloatingBallOpacitySlider" Minimum="0.2" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="False" ValueChanged="Changed" Margin="0,8,0,16"/></StackPanel>
   <StackPanel x:Name="AppearancePage" Visibility="Collapsed"><TextBlock Text="應用主題"/><ComboBox x:Name="Theme" SelectionChanged="Changed" Margin="0,8,0,16"><ComboBoxItem Content="清透玻璃" Tag="Acrylic"/><ComboBoxItem Content="蜂蜜暖色" Tag="Honey"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox><TextBlock Text="背景透明度（0%–100%）"/><Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="False" ValueChanged="Changed" Margin="0,8,0,16"/><TextBlock Text="界面字體"/><ComboBox x:Name="InterfaceFontFamily" SelectionChanged="Changed" Margin="0,8,0,8"><ComboBoxItem Content="Microsoft JhengHei UI"/><ComboBoxItem Content="Microsoft YaHei UI"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Consolas"/></ComboBox><Slider x:Name="InterfaceFontSlider" Minimum="11" Maximum="22" TickFrequency="1" ValueChanged="Changed" Margin="0,0,0,16"/><TextBlock Text="內容字體"/><ComboBox x:Name="GlobalFontFamily" SelectionChanged="Changed" Margin="0,8,0,8"><ComboBoxItem Content="Microsoft JhengHei UI"/><ComboBoxItem Content="Microsoft YaHei UI"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Consolas"/></ComboBox><Slider x:Name="FontSlider" Minimum="11" Maximum="24" TickFrequency="1" ValueChanged="Changed" Margin="0,0,0,16"/><TextBlock Text="全局文字顏色"/><Grid Margin="0,8,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GlobalFontColor" LostFocus="GlobalFontColor_Changed" KeyDown="GlobalFontColor_KeyDown"/><Button x:Name="GlobalFontColorPicker" Grid.Column="1" Content="🎨" Width="34" Margin="8,0,0,0" Padding="0" Click="GlobalFontColorPicker_Click" ToolTip="打開調色盤"/><UniformGrid Grid.Column="2" Columns="8" Margin="8,0,0,0"><Button Width="26" Height="26" Padding="0" Background="#0D1321" Tag="#0D1321" Click="GlobalFontColor_Click"/><Button Width="26" Height="26" Padding="0" Background="#FFFFFF" Tag="#FFFFFF" Click="GlobalFontColor_Click"/><Button Width="26" Height="26" Padding="0" Background="#FF8A00" Tag="#FF8A00" Click="GlobalFontColor_Click"/><Button Width="26" Height="26" Padding="0" Background="#D92D20" Tag="#D92D20" Click="GlobalFontColor_Click"/><Button Width="26" Height="26" Padding="0" Background="#175CD3" Tag="#175CD3" Click="GlobalFontColor_Click"/><Button Width="26" Height="26" Padding="0" Background="#067647" Tag="#067647" Click="GlobalFontColor_Click"/><Button Width="26" Height="26" Padding="0" Background="#7F56D9" Tag="#7F56D9" Click="GlobalFontColor_Click"/><Button Width="26" Height="26" Padding="0" Background="#667085" Tag="#667085" Click="GlobalFontColor_Click"/></UniformGrid></Grid><TextBlock Text="視窗圓角"/><Slider x:Name="CornerSlider" Minimum="0" Maximum="28" ValueChanged="Changed" Margin="0,8"/><TextBlock Text="共享格子背景" FontWeight="SemiBold" Margin="0,16,0,4"/><TextBlock Text="所有格子共用同一張背景圖片；也可在單個格子的 ⚙ 菜單單獨設定。" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,8"/><CheckBox x:Name="SharedBackground" Content="所有格子共用背景" Checked="Changed" Unchecked="Changed" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="選擇背景圖片" Click="ChooseSharedBackground_Click"/><Button Content="清除背景" Click="ClearSharedBackground_Click" Margin="8,0,0,0"/></StackPanel></StackPanel>
   <StackPanel x:Name="FilesPage" Visibility="Collapsed"><TextBlock Text="圖標大小"/><Slider x:Name="IconSlider" Minimum="18" Maximum="64" ValueChanged="Changed" Margin="0,8,0,18"/><TextBlock Text="項目間距"/><Slider x:Name="SpacingSlider" Minimum="2" Maximum="24" ValueChanged="Changed" Margin="0,8,0,18"/><CheckBox x:Name="Extensions" Content="顯示文件副檔名" Checked="Changed" Unchecked="Changed"/></StackPanel>
   <StackPanel x:Name="FeaturesPage" Visibility="Collapsed">
    <TextBlock Text="BeeX 圖片庫" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock Text="剪貼板圖片和螢幕截圖分開保存；修改路徑只影響之後新增的圖片。" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="剪貼板圖片資料夾"/>
    <Grid Margin="0,6,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ClipboardImagePath" LostFocus="ImagePath_Changed" KeyDown="ImagePath_KeyDown"/><Button Grid.Column="1" Content="選擇" Tag="Clipboard" Click="ChooseImageFolder_Click"/><Button Grid.Column="2" Content="開啟" Tag="Clipboard" Click="OpenImageFolder_Click"/></Grid>
    <TextBlock Text="螢幕截圖資料夾"/>
    <Grid Margin="0,6,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ScreenshotPath" LostFocus="ImagePath_Changed" KeyDown="ImagePath_KeyDown"/><Button Grid.Column="1" Content="選擇" Tag="Screenshot" Click="ChooseImageFolder_Click"/><Button Grid.Column="2" Content="開啟" Tag="Screenshot" Click="OpenImageFolder_Click"/></Grid>
    <TextBlock Text="DeepL API Key" FontWeight="SemiBold" Margin="0,18,0,4"/>
    <TextBlock Text="留空则使用内置 Key，或前往 deepl.com/pro-api 获取免费 Key" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBox x:Name="DeepLApiKeyBox" LostFocus="DeepLApiKey_Changed" KeyDown="DeepLApiKey_KeyDown"/>
    <TextBlock x:Name="TranslateTargetLabel" Text="截圖翻譯目標語言" FontWeight="SemiBold" Margin="0,18,0,4"/>
    <ComboBox x:Name="TranslateTargetBox" SelectionChanged="TranslateTarget_Changed"/>
    <TextBlock Text="主控制台功能按鈕" FontWeight="SemiBold" Margin="0,18,0,4"/>
    <TextBlock Text="在這裡控制主控制台上方功能按鈕的顯示、隱藏與排序。" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <StackPanel x:Name="FeatureNestListPanel" AllowDrop="True" Drop="FeatureRow_Drop" DragOver="FeatureRow_DragOver"/>
   </StackPanel>
   <StackPanel x:Name="TodoSettingsPage" Visibility="Collapsed"><TextBlock Text="待辦提醒" FontWeight="SemiBold"/><TextBlock Text="待辦的截止日期、提前提醒、顏色標記和重複規則在每個任務詳情中設定。" Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,14"/><TextBlock Text="新待辦默認提醒" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="僅影響之後新建的待辦；已有待辦可在詳情中單獨修改。" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,8"/><CheckBox x:Name="TodoRemWeek" Content="一週前" Checked="TodoDefaultReminder_Changed" Unchecked="TodoDefaultReminder_Changed" Margin="0,4"/><CheckBox x:Name="TodoRem3Day" Content="三天前" Checked="TodoDefaultReminder_Changed" Unchecked="TodoDefaultReminder_Changed" Margin="0,4"/><CheckBox x:Name="TodoRemDay" Content="一天前" Checked="TodoDefaultReminder_Changed" Unchecked="TodoDefaultReminder_Changed" Margin="0,4"/><CheckBox x:Name="TodoRemHour" Content="一小時前" Checked="TodoDefaultReminder_Changed" Unchecked="TodoDefaultReminder_Changed" Margin="0,4"/><CheckBox x:Name="TodoRemOnTime" Content="準時" Checked="TodoDefaultReminder_Changed" Unchecked="TodoDefaultReminder_Changed" Margin="0,4"/></StackPanel>
   <StackPanel x:Name="CaptureSettingsPage" Visibility="Collapsed"><TextBlock Text="隨記圖庫" FontWeight="SemiBold"/><TextBlock Text="剪貼板文字、剪貼板圖片、螢幕截圖和手動隨記會分開標記；圖片保存路徑可在「功能格子」總覽中修改。" Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,14"/><TextBlock Text="隨記保留上限" FontWeight="SemiBold" Margin="0,0,0,4"/><Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="超過上限時自動刪除最舊的隨記。" Foreground="#667085"/><TextBlock x:Name="CaptureLimitValue" Grid.Column="1" Text="100"/></Grid><Slider x:Name="CaptureLimitSlider" Minimum="20" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Changed" Margin="0,0,0,16"/><StackPanel HorizontalAlignment="Left" Width="240"><Button Content="打開剪貼板圖片資料夾" HorizontalAlignment="Stretch" Tag="Clipboard" Click="OpenImageFolder_Click"/><Button Content="打開螢幕截圖資料夾" HorizontalAlignment="Stretch" Tag="Screenshot" Click="OpenImageFolder_Click" Margin="0,8,0,0"/></StackPanel></StackPanel>
   <StackPanel x:Name="CaptureRecordPage" Visibility="Collapsed"><TextBlock Text="截圖" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="默認保存格式"/><ComboBox x:Name="CaptureFormatBox" SelectionChanged="Changed" HorizontalAlignment="Left" MinWidth="170" Margin="0,6,0,10"><ComboBoxItem Content="PNG" Tag="png"/><ComboBoxItem Content="JPG" Tag="jpg"/><ComboBoxItem Content="BMP" Tag="bmp"/><ComboBoxItem Content="TIFF" Tag="tiff"/></ComboBox><CheckBox x:Name="CaptureCopyToClipboard" Content="保存截圖時同時複製到剪貼板" Checked="Changed" Unchecked="Changed" Margin="0,4,0,16"/><TextBlock Text="錄屏" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="錄屏默認幀率"/><ComboBox x:Name="RecordFpsBox" SelectionChanged="Changed" HorizontalAlignment="Left" MinWidth="170" Margin="0,6,0,10"><ComboBoxItem Content="5 FPS" Tag="5"/><ComboBoxItem Content="10 FPS" Tag="10"/><ComboBoxItem Content="15 FPS" Tag="15"/><ComboBoxItem Content="24 FPS" Tag="24"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="48 FPS" Tag="48"/><ComboBoxItem Content="60 FPS" Tag="60"/></ComboBox><TextBlock Text="錄屏默認倒數"/><ComboBox x:Name="RecordDelayBox" SelectionChanged="Changed" HorizontalAlignment="Left" MinWidth="170" Margin="0,6,0,10"><ComboBoxItem Content="0 s" Tag="0"/><ComboBoxItem Content="3 s" Tag="3"/><ComboBoxItem Content="5 s" Tag="5"/><ComboBoxItem Content="10 s" Tag="10"/></ComboBox><TextBlock Text="錄屏工具條內仍可單次切換格式、幀率與倒數。" Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,14"/><StackPanel Orientation="Horizontal"><Button Content="打開螢幕截圖資料夾" Tag="Screenshot" Click="OpenImageFolder_Click"/><Button Content="打開錄屏資料夾" Click="OpenRecordingsFolder_Click" Margin="8,0,0,0"/></StackPanel></StackPanel>
   <StackPanel x:Name="MusicSettingsPage" Visibility="Collapsed"><TextBlock Text="音樂歌詞" FontWeight="SemiBold"/><TextBlock Text="音樂格子會自動讀取系統正在播放的媒體，並嘗試匹配本機與網路歌詞；多個播放器同時播放時會提示選擇。" Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,18"/><StackPanel x:Name="MusicGlobalSettingsPanel"/></StackPanel>
   <StackPanel x:Name="WeatherSettingsPage" Visibility="Collapsed"><TextBlock Text="天氣" FontWeight="SemiBold"/><TextBlock Text="天氣格子預設顯示今天；拉大格子後會顯示 5 天或 7 天預報。城市可在天氣格子中雙擊城市文字修改。" Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,18"/><TextBlock Text="默認城市"/><Grid Margin="0,6,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WeatherDefaultCity" KeyDown="WeatherDefaultCity_KeyDown" LostFocus="WeatherDefaultCity_Changed"/><Button Grid.Column="1" Content="套用到所有天氣格子" Click="ApplyWeatherCity_Click"/></Grid><TextBlock Text="自動刷新間隔" FontWeight="SemiBold" Margin="0,6,0,4"/><ComboBox x:Name="WeatherRefreshBox" SelectionChanged="Changed" HorizontalAlignment="Left" MinWidth="170" Margin="0,4,0,6"><ComboBoxItem Content="不自動刷新" Tag="0"/><ComboBoxItem Content="15 分鐘" Tag="15"/><ComboBoxItem Content="30 分鐘" Tag="30"/><ComboBoxItem Content="60 分鐘" Tag="60"/><ComboBoxItem Content="120 分鐘" Tag="120"/></ComboBox><TextBlock Text="新間隔對之後打開的天氣格子生效；已開啟的格子重新顯示後生效。" Foreground="#667085" TextWrapping="Wrap"/></StackPanel>
   <StackPanel x:Name="HotkeysPage" Visibility="Collapsed"><CheckBox x:Name="AlignToGrid" Content="格子對齊網格線" Checked="Changed" Unchecked="Changed" Margin="0,0,0,5"/><Grid Margin="0,4,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="網格大小"/><TextBlock x:Name="GridSizeValue" Grid.Column="1" Text="20 px"/></Grid><Slider x:Name="GridSizeSlider" Minimum="10" Maximum="80" TickFrequency="1" ValueChanged="Changed" Margin="0,0,0,10"/><TextBlock Text="拖動格子後，自動吸附到最近的網格交點。" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,18"/><TextBlock Text="點擊欄位後按下組合鍵；按 Esc 清除。修改後立即生效。" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel x:Name="HotkeyEditorPanel"/><TextBlock Text="快捷鍵為全域快捷鍵，程式在系統匣時仍有效。" Foreground="#667085" Margin="0,12"/></StackPanel>
   <StackPanel x:Name="CleanerPage" Visibility="Collapsed"><TextBlock Text="BeeX 清理" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="快速卸载软件、清理注册表与安装目录残留。" Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,18"/><Button Content="启动清理" Width="120" Height="36" Click="LaunchCleaner_Click" HorizontalAlignment="Left"/></StackPanel>
   <StackPanel x:Name="MaintenancePage" Visibility="Collapsed"><Button Content="打開收納根目錄" Click="OpenStorage_Click" HorizontalAlignment="Left"/><TextBlock Text="ffmpeg 元件" FontWeight="SemiBold" Margin="0,18,0,4"/><TextBlock Text="錄屏、GIF 與視頻剪輯需要 ffmpeg；不再內置，可在此提前下載到 BeeX 資料目錄。" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><Button x:Name="FfmpegDownloadBtn" Content="下載 ffmpeg 元件" Click="DownloadFfmpeg_Click" HorizontalAlignment="Left"/><TextBlock x:Name="FfmpegStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#667085"/></StackPanel><ProgressBar x:Name="FfmpegProgressBar" Width="420" Height="6" Minimum="0" Maximum="100" HorizontalAlignment="Left" Margin="0,8,0,0" Foreground="#FF8A00" Visibility="Collapsed"/><TextBlock Text="OCR 元件" FontWeight="SemiBold" Margin="0,18,0,4"/><TextBlock Text="截圖辨識與翻譯需要 OCR 元件（約 600 MB）；不再內置，可在此提前下載到 BeeX 資料目錄。" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><Button x:Name="OcrDownloadBtn" Content="安裝 OCR 辨識" Click="DownloadOcr_Click" HorizontalAlignment="Left"/><TextBlock x:Name="OcrStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#667085"/></StackPanel><ProgressBar x:Name="OcrProgressBar" Width="420" Height="6" Minimum="0" Maximum="100" HorizontalAlignment="Left" Margin="0,8,0,0" Foreground="#FF8A00" Visibility="Collapsed"/><Button Content="重置偏好設定" Click="Reset_Click" HorizontalAlignment="Left" Foreground="#B42318" Margin="4,18"/><TextBlock Text="重置保留語言與開機啟動，不刪除使用者文件。" Foreground="#667085"/></StackPanel>
   <StackPanel x:Name="AboutPage" Visibility="Collapsed"><Image Source="pack://application:,,,/Assets/BeeX.png" Width="82" Height="82" HorizontalAlignment="Left"/><TextBlock Text="BeeX DeskNest" FontSize="24" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="Flow Faster. Work Smarter." Foreground="#667085"/><TextBlock Text="作者" FontWeight="SemiBold" Margin="0,22,0,8"/><StackPanel x:Name="AuthorLinksPanel" Orientation="Horizontal"/></StackPanel>
  </Grid></ScrollViewer></Grid>
 </Grid>
</Window>
