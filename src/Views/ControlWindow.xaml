<Window x:Class="BeeX.DeskNest.ControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BeeX DeskNest" Width="880" Height="650" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#F5F6F8"><Window.Resources><SolidColorBrush x:Key="ControlPrimary" Color="#0D1321"/><SolidColorBrush x:Key="ControlSecondary" Color="#6B7280"/><SolidColorBrush x:Key="ControlSurface" Color="#FFFFFF"/><SolidColorBrush x:Key="ControlLine" Color="#EEF0F3"/></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <UniformGrid x:Name="ToolGrid" Grid.Row="0" Columns="5" Rows="2" Margin="0,4,0,16"><Button Tag="Note" Click="AddNote_Click"/><Button Tag="Todo" Click="AddTodo_Click"/><Button Tag="MapFolder" Click="AddFolder_Click"/><Button Tag="Managed" Click="AddManaged_Click" Background="#FF8A00" Foreground="White"/><Button Tag="CaptureFolder" Click="OpenCaptures_Click" Background="#0D1321" Foreground="White"/><Button Tag="QuickNote" Click="AddCapture_Click"/><Button Tag="Music" Click="AddMusic_Click"/><Button Tag="Clock" Click="AddClock_Click"/><Button Tag="Screenshot" Click="CaptureNow_Click"/><Button Tag="ToggleAll" Click="ToggleAll_Click"/></UniformGrid>
  <Border Grid.Row="2" Background="{DynamicResource ControlSurface}" CornerRadius="14" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="NestList" AllowDrop="True" PreviewMouseMove="NestList_MouseMove" Drop="NestList_Drop" MouseDoubleClick="NestList_DoubleClick" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource ControlLine}" BorderThickness="0,0,0,1" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#FFF3E5"><Image Source="{Binding Icon}" Width="20" Height="20"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource ControlPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource ControlSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Tag="{Binding Model}" Click="Toggle_Click" ToolTip="{Binding ToggleText}" Focusable="False"><StackPanel Orientation="Horizontal"><Image Source="{Binding ToggleIcon}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding ToggleText}" VerticalAlignment="Center"/></StackPanel></Button><Button Tag="{Binding Model}" Click="Delete_Click" Foreground="#B42318" ToolTip="{Binding DeleteText}" Focusable="False"><StackPanel Orientation="Horizontal"><Image Source="{Binding DeleteIcon}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding DeleteText}" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="1" HorizontalAlignment="Right" Foreground="#B42318" Click="ClearAll_Click" Margin="8" x:Name="ClearAllButton"><StackPanel Orientation="Horizontal"><Image x:Name="ClearAllIcon" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock x:Name="ClearAllText" Text="清除全部" VerticalAlignment="Center"/></StackPanel></Button></Grid></Border>
  <Grid Grid.Row="3" Margin="0,16,0,0"><CheckBox x:Name="StartupCheck" Content="登入 Windows 時自動啟動" Foreground="{DynamicResource ControlPrimary}" VerticalAlignment="Center" Checked="Startup_Changed" Unchecked="Startup_Changed"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="ShortcutHint" Foreground="{DynamicResource ControlSecondary}" VerticalAlignment="Center"/><Button Click="ArrangeLayout_Click" Margin="14,0,0,0" x:Name="ArrangeLayoutButton"><StackPanel Orientation="Horizontal"><Image x:Name="ArrangeLayoutIcon" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock x:Name="ArrangeLayoutText" Text="整理布局" VerticalAlignment="Center"/></StackPanel></Button><Button Click="Settings_Click" Margin="8,0,0,0" x:Name="SettingsButton"><StackPanel Orientation="Horizontal"><Image x:Name="SettingsIcon" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock x:Name="SettingsText" Text="設定" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></Grid>
 </Grid>
</Window>
