<Window x:Class="BeeXCleaner.Views.OrphanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="遗留扫描 · 清理已卸载软件的残留"
        Height="600" Width="900"
        MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,6">
            <TextBlock x:Name="ScanInfo" Text="正在扫描遗留项…" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                       Text="这些是“软件已卸载、但仍残留在本机”的记录：失效快捷方式、死卸载项、孤儿 App Paths、失效自启动项，以及 Program Files 下不属于任何已安装程序的孤立残留文件夹。"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="16,4,16,8" CornerRadius="4" Padding="10,8"
                Background="#FFEAF3FF" BorderBrush="#FF9DC3F0" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" Foreground="#FF1A4E8A"
                       Text="失效引用类判据严格、默认已勾选；孤立文件夹为“疑似残留”、默认不勾选，请务必核对后再删。网络盘 / NAS 与系统关键目录一律忽略；勾选项将被永久删除。"/>
        </Border>

        <DataGrid x:Name="OrphanGrid" Grid.Row="2" Margin="16,0,16,0"
                  AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="28" Background="White"
                  BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                  HorizontalGridLinesBrush="#FFF0F1F3">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" Width="72" IsReadOnly="True"/>
                <DataGridTextColumn Header="位置" Binding="{Binding Path}" Width="1.3*" IsReadOnly="True"/>
                <DataGridTextColumn Header="说明" Binding="{Binding MatchReason}" Width="1.7*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{StaticResource ToolbarBg}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="全选" Style="{StaticResource GhostButton}" Click="OnSelectAll" Margin="0,0,8,0"/>
                    <Button Content="全不选" Style="{StaticResource GhostButton}" Click="OnSelectNone" Margin="0,0,8,0"/>
                    <Button x:Name="DeepScanBtn" Content="🔍 深度扫描" Style="{StaticResource GhostButton}"
                            Click="OnDeepScan"
                            ToolTip="附加扫描计划任务/服务/PATH/防火墙/文件关联中“目标已不存在”的遗留项（默认不勾选）"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                    <CheckBox x:Name="SecureErase" VerticalAlignment="Center" Margin="0,0,16,0"
                              Content="安全擦除（覆盖字节·防恢复）"
                              ToolTip="删除前用随机字节覆盖文件内容并写盘，使数据无法被恢复工具还原（会更慢）"/>
                    <CheckBox x:Name="KillProcesses" VerticalAlignment="Center" Margin="0,0,16,0"
                              Content="结束占用进程"
                              ToolTip="勾选后：遇到被占用的文件会尝试结束占用它的非系统进程再删除。可能关闭正在运行的程序，请先保存数据。"/>
                    <TextBlock x:Name="StatusInfo" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="清理选中项" Style="{StaticResource DangerButton}"
                        Click="OnClean" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="关闭" Style="{StaticResource GhostButton}"
                        Click="OnClose"/>
            </Grid>
        </Border>

        <Border x:Name="BusyOverlay" Grid.Row="2" Background="#B0FFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="6"
                             Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="BusyText" Text="正在扫描遗留项…" Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
