<Window x:Class="BeeXCleaner.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清理结果"
        Height="560" Width="600"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="清理完成" FontSize="17" FontWeight="SemiBold"/>

        <!-- Summary Card -->
        <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="6" Padding="16,12"
                Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="DeletedText" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="成功删除" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="RebootText" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="重启后删除" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="FailedText" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="失败" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock x:Name="FreedText" Text="0 B" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="释放空间" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Backup Tips -->
        <Border x:Name="BackupBar" Grid.Row="2" Margin="0,12,0,0" CornerRadius="4" Padding="10,8"
                Background="#FFEAF3FF" BorderBrush="#FF9DC3F0" BorderThickness="1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💾 已在清理前自动备份注册表。" Foreground="#FF1A4E8A" VerticalAlignment="Center"/>
                <Button x:Name="OpenBackupBtn" Content="打开备份目录" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Padding="8,3" Click="OnOpenBackup"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="LogPathText" Grid.Row="3" Margin="2,10,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}" Visibility="Collapsed"/>

        <!-- Detailed Log -->
        <Border Grid.Row="4" Margin="0,12,0,0" CornerRadius="4"
                Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" Padding="10,8"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
        </Border>

        <!-- Bottom Button -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OpenLogBtn" Content="打开日志文件" Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" Click="OnOpenLog"/>
            <Button Content="导出(.txt)" Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" Click="OnExportTxt"/>
            <Button Content="导出(.json)" Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" Click="OnExportJson"/>
            <Button Content="关闭" Style="{StaticResource FlatButton}" Click="OnClose" MinWidth="72"/>
        </StackPanel>
    </Grid>
</Window>
