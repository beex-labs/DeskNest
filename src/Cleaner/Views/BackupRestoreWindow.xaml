<Window x:Class="BeeXCleaner.Views.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份恢复 · 注册表清理前的自动备份"
        Height="560" Width="820"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="备份恢复" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                   Text="每次清理注册表前，BeeX Cleaner 会把受影响的注册表项导出为 .reg 备份。若清理后出现异常，可在此选择对应会话运行 .reg 文件恢复。"/>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.6*"/>
            </Grid.ColumnDefinitions>

            <!-- Session List -->
            <Border Grid.Column="0" CornerRadius="4" Background="White"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="清理会话" FontWeight="SemiBold"
                               Padding="10,8" Background="{StaticResource HeaderBg}"/>
                    <ListBox x:Name="SessionList" BorderThickness="0" Margin="2"
                             SelectionChanged="OnSessionChanged"/>
                </DockPanel>
            </Border>

            <!-- List of Backup Files -->
            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="4" Background="White"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="备份文件（.reg / PATH）" FontWeight="SemiBold"
                               Padding="10,8" Background="{StaticResource HeaderBg}"/>
                    <ListBox x:Name="FileList" BorderThickness="0" Margin="2"/>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource ToolbarBg}" Margin="0,12,0,0"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12,10" CornerRadius="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="刷新" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnRefresh"/>
                <Button Content="打开会话目录" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnOpenFolder"/>
                <Button Content="恢复选中的备份(.reg)" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="OnRestore"/>
                <Button Content="关闭" Style="{StaticResource FlatButton}" Click="OnClose" MinWidth="72"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
