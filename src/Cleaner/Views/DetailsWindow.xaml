<Window x:Class="BeeXCleaner.Views.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程序详情"
        Height="480" Width="620"
        MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding PublisherDisplay}" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Details Table -->
        <Border Grid.Row="1" Background="White" CornerRadius="6"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Style="{StaticResource Label}"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding VersionDisplay, Mode=OneWay}" Style="{StaticResource Value}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="大小" Style="{StaticResource Label}"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding SizeDisplay, Mode=OneWay}" Style="{StaticResource Value}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="安装日期" Style="{StaticResource Label}"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding InstallDateDisplay, Mode=OneWay}" Style="{StaticResource Value}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="架构" Style="{StaticResource Label}"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding ArchDisplay, Mode=OneWay}" Style="{StaticResource Value}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="安装目录" Style="{StaticResource Label}"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding InstallLocation, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource Value}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="卸载命令" Style="{StaticResource Label}"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding UninstallString, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource Value}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="注册表" Style="{StaticResource Label}"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding FullRegistryPath, Mode=OneWay}" Style="{StaticResource Value}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="官网" Style="{StaticResource Label}"/>
                    <TextBox   Grid.Row="7" Grid.Column="1" Text="{Binding UrlInfoAbout, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource Value}"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Bottom Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="打开安装目录" Style="{StaticResource GhostButton}" Click="OnOpenFolder" Margin="0,0,8,0"/>
            <Button Content="定位注册表" Style="{StaticResource GhostButton}" Click="OnOpenRegistry" Margin="0,0,8,0"/>
            <Button Content="访问官网" Style="{StaticResource GhostButton}" Click="OnOpenWebsite" Margin="0,0,8,0"/>
            <Button Content="关闭" Style="{StaticResource FlatButton}" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
