<Window x:Class="BeeXCleaner.Views.CleanupHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清理历史 · 会话日志"
        Height="580" Width="860"
        MinHeight="420" MinWidth="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="清理历史" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="4" Background="White"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="日志文件" FontWeight="SemiBold"
                               Padding="10,8" Background="{StaticResource HeaderBg}"/>
                    <ListBox x:Name="LogList" BorderThickness="0" Margin="2"
                             SelectionChanged="OnLogChanged"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="4" Background="White"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <TextBox x:Name="ContentBox" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent" Padding="10,8"
                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource ToolbarBg}" Margin="0,12,0,0"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12,10" CornerRadius="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="刷新" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnRefresh"/>
                <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnOpenFolder"/>
                <Button Content="关闭" Style="{StaticResource FlatButton}" Click="OnClose" MinWidth="72"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
