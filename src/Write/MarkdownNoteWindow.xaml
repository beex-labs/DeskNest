<Window x:Class="BeexWrite.MarkdownNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ctl="clr-namespace:BeexWrite.Controls"
        xmlns:conv="clr-namespace:BeexWrite.Converters"
        xmlns:loc="clr-namespace:BeexWrite.Localization"
        Title="{Binding DisplayTitle}"
        Width="1080" Height="760"
        MinWidth="640" MinHeight="420"
        WindowStyle="None"
        Topmost="{Binding AlwaysOnTop}"
        Background="{DynamicResource Bx.WindowBackground}"
        Foreground="{DynamicResource Bx.Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="65" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0: active palette (swapped at runtime by ThemeService, follows DeskNest theme). -->
                <ResourceDictionary Source="pack://application:,,,/Write/Themes/Light.xaml" />
                <!-- Index 1: BeexWrite control styles (window-scoped so DeskNest styles stay untouched). -->
                <ResourceDictionary Source="pack://application:,,,/Write/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StringEqualsConverter x:Key="StrEq" />
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:LevelToMarginConverter x:Key="OutlineMargin" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Bx.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Title bar ============ -->
            <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="65" Background="{DynamicResource Bx.Chrome}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="pack://application:,,,/Write/Assets/branding/BeeX.png"
                           Width="18" Height="18" Margin="10,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="BeexWrite" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource Bx.Text}" Margin="0,0,10,0" />

                    <!-- ============ Main menu ============ -->
                    <Menu VerticalAlignment="Center" Foreground="{DynamicResource Bx.Text}">
                        <MenuItem Header="{Binding MenuFile, Source={x:Static loc:Strings.Instance}}">
                            <MenuItem Header="{Binding MenuOpen, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+O" Command="{Binding OpenFileCommand}" />
                            <MenuItem Header="{Binding MenuQuickOpen, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+P" Command="{Binding QuickOpenCommand}" />
                            <MenuItem Header="{Binding MenuOpenRecent, Source={x:Static loc:Strings.Instance}}" ItemsSource="{Binding RecentFiles}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Name}" />
                                        <Setter Property="Command"
                                                Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter Property="CommandParameter" Value="{Binding FullPath}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <MenuItem Header="{Binding MenuReopenClosed, Source={x:Static loc:Strings.Instance}}" Command="{Binding ReopenClosedCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding MenuSave, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                            <MenuItem Header="{Binding MenuSaveAs, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding MenuImport, Source={x:Static loc:Strings.Instance}}">
                                <MenuItem Header="{Binding MenuImportPandoc, Source={x:Static loc:Strings.Instance}}" Command="{Binding ImportViaPandocCommand}" />
                                <MenuItem Header="{Binding MenuImportTextBundle, Source={x:Static loc:Strings.Instance}}" Command="{Binding ImportTextBundleCommand}" />
                            </MenuItem>
                            <MenuItem Header="{Binding MenuExport, Source={x:Static loc:Strings.Instance}}">
                                <MenuItem Header="{Binding MenuExportHtml, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExportHtmlCommand}" />
                                <MenuItem Header="{Binding MenuExportHtmlPlain, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExportHtmlPlainCommand}" />
                                <MenuItem Header="{Binding MenuExportPdf, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExportPdfCommand}" />
                                <MenuItem Header="{Binding MenuExportLongImage, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExportLongImageCommand}" />
                                <MenuItem Header="{Binding MenuExportPandoc, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExportViaPandocCommand}" />
                                <Separator />
                                <MenuItem Header="{Binding MenuDownloadImages, Source={x:Static loc:Strings.Instance}}" Command="{Binding DownloadImagesCommand}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{Binding MenuPreferences, Source={x:Static loc:Strings.Instance}}" Command="{Binding OpenPreferencesCommand}" />
                            <MenuItem Header="{Binding MenuPrint, Source={x:Static loc:Strings.Instance}}" Click="OnPrint" InputGestureText="Ctrl+Shift+P" />
                        </MenuItem>

                        <MenuItem Header="{Binding MenuEdit, Source={x:Static loc:Strings.Instance}}">
                            <MenuItem Header="{Binding MenuUndo, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+Z" Command="{Binding ExecEditorCommand}" CommandParameter="undo" />
                            <MenuItem Header="{Binding MenuRedo, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+Y" Command="{Binding ExecEditorCommand}" CommandParameter="redo" />
                            <Separator />
                            <MenuItem Header="{Binding MenuCut, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+X" Command="{Binding ExecEditorCommand}" CommandParameter="cut" />
                            <MenuItem Header="{Binding MenuCopy, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+C" Command="{Binding ExecEditorCommand}" CommandParameter="copy" />
                            <MenuItem Header="{Binding MenuPaste, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+V" Command="{Binding ExecEditorCommand}" CommandParameter="paste" />
                            <MenuItem Header="{Binding MenuCopyAsMarkdown, Source={x:Static loc:Strings.Instance}}" Command="{Binding CopyAsMarkdownCommand}" />
                            <MenuItem Header="{Binding MenuCopyAsHtml, Source={x:Static loc:Strings.Instance}}" Command="{Binding CopyAsHtmlCommand}" />
                            <MenuItem Header="{Binding MenuPasteAsPlain, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="pastePlain" />
                            <Separator />
                            <MenuItem Header="{Binding MenuSelectAll, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+A" Command="{Binding ExecEditorCommand}" CommandParameter="selectAll" />
                            <Separator />
                            <MenuItem Header="{Binding MenuFind, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+F" Command="{Binding ExecEditorCommand}" CommandParameter="find" />
                            <MenuItem Header="{Binding MenuReplace, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+H" Command="{Binding ExecEditorCommand}" CommandParameter="find" />
                        </MenuItem>

                        <MenuItem Header="{Binding MenuParagraph, Source={x:Static loc:Strings.Instance}}">
                            <MenuItem Header="{Binding MenuHeading1, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+1" Command="{Binding ExecEditorCommand}" CommandParameter="heading1" />
                            <MenuItem Header="{Binding MenuHeading2, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+2" Command="{Binding ExecEditorCommand}" CommandParameter="heading2" />
                            <MenuItem Header="{Binding MenuHeading3, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+3" Command="{Binding ExecEditorCommand}" CommandParameter="heading3" />
                            <MenuItem Header="{Binding MenuHeading4, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+4" Command="{Binding ExecEditorCommand}" CommandParameter="heading4" />
                            <MenuItem Header="{Binding MenuHeading5, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+5" Command="{Binding ExecEditorCommand}" CommandParameter="heading5" />
                            <MenuItem Header="{Binding MenuHeading6, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+6" Command="{Binding ExecEditorCommand}" CommandParameter="heading6" />
                            <MenuItem Header="{Binding MenuParagraphNormal, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+0" Command="{Binding ExecEditorCommand}" CommandParameter="paragraph" />
                            <Separator />
                            <MenuItem Header="{Binding MenuPromoteHeading, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+]" Command="{Binding ExecEditorCommand}" CommandParameter="promoteHeading" />
                            <MenuItem Header="{Binding MenuDemoteHeading, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+[" Command="{Binding ExecEditorCommand}" CommandParameter="demoteHeading" />
                            <Separator />
                            <MenuItem Header="{Binding MenuOrderedList, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="orderedList" />
                            <MenuItem Header="{Binding MenuUnorderedList, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="bulletList" />
                            <MenuItem Header="{Binding MenuTaskList, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="taskList" />
                            <Separator />
                            <MenuItem Header="{Binding MenuQuote, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="quote" />
                            <MenuItem Header="{Binding MenuCodeFence, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="codeFence" />
                            <MenuItem Header="{Binding MenuMathBlock, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="mathBlock" />
                            <MenuItem Header="{Binding MenuMermaid, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="mermaid" />
                            <Separator />
                            <MenuItem Header="{Binding MenuTable, Source={x:Static loc:Strings.Instance}}" Command="{Binding InsertTableCommand}" />
                            <MenuItem Header="{Binding MenuHorizontalRule, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="horizontalRule" />
                        </MenuItem>

                        <MenuItem Header="{Binding MenuFormat, Source={x:Static loc:Strings.Instance}}">
                            <MenuItem Header="{Binding MenuBold, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+B" Command="{Binding ExecEditorCommand}" CommandParameter="bold" />
                            <MenuItem Header="{Binding MenuItalic, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+I" Command="{Binding ExecEditorCommand}" CommandParameter="italic" />
                            <MenuItem Header="{Binding MenuUnderline, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+U" Command="{Binding ExecEditorCommand}" CommandParameter="underline" />
                            <MenuItem Header="{Binding MenuStrikethrough, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="strikethrough" />
                            <MenuItem Header="{Binding MenuHighlight, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="highlight" />
                            <MenuItem Header="{Binding MenuInlineCode, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="inlineCode" />
                            <Separator />
                            <MenuItem Header="{Binding MenuSuperscript, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="superscript" />
                            <MenuItem Header="{Binding MenuSubscript, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="subscript" />
                            <Separator />
                            <MenuItem Header="{Binding MenuInsertLink, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="link" />
                            <MenuItem Header="{Binding MenuInsertImage, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="image" />
                            <Separator />
                            <MenuItem Header="{Binding MenuHardLineBreak, Source={x:Static loc:Strings.Instance}}" InputGestureText="Shift+Enter" Command="{Binding ExecEditorCommand}" CommandParameter="hardBreak" />
                            <MenuItem Header="{Binding MenuClearFormat, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="clearFormat" />
                        </MenuItem>

                        <MenuItem Header="{Binding MenuView, Source={x:Static loc:Strings.Instance}}">
                            <MenuItem Header="{Binding MenuToggleSidebar, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+\" IsChecked="{Binding SidebarVisible}" Command="{Binding ToggleSidebarCommand}" />
                            <MenuItem Header="{Binding MenuSourceCodeMode, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+/" IsChecked="{Binding SourceMode}" Command="{Binding ToggleSourceCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding MenuFocusMode, Source={x:Static loc:Strings.Instance}}" IsChecked="{Binding FocusMode}" Command="{Binding ToggleFocusCommand}" />
                            <MenuItem Header="{Binding MenuTypewriterMode, Source={x:Static loc:Strings.Instance}}" IsChecked="{Binding TypewriterMode}" Command="{Binding ToggleTypewriterCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding MenuZoomIn, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+=" Command="{Binding ZoomInCommand}" />
                            <MenuItem Header="{Binding MenuZoomOut, Source={x:Static loc:Strings.Instance}}" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}" />
                            <MenuItem Header="{Binding MenuResetZoom, Source={x:Static loc:Strings.Instance}}" Command="{Binding ZoomResetCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding MenuRefreshRendering, Source={x:Static loc:Strings.Instance}}" Command="{Binding ExecEditorCommand}" CommandParameter="refreshRender" />
                            <Separator />
                            <MenuItem Header="{Binding MenuToggleStatusBar, Source={x:Static loc:Strings.Instance}}" IsChecked="{Binding StatusBarVisible}" Command="{Binding ToggleStatusBarCommand}" />
                            <MenuItem Header="{Binding MenuFullScreen, Source={x:Static loc:Strings.Instance}}" InputGestureText="F11" IsChecked="{Binding IsFullScreen}" Command="{Binding ToggleFullScreenCommand}" />
                            <MenuItem Header="{Binding MenuAlwaysOnTop, Source={x:Static loc:Strings.Instance}}" IsChecked="{Binding AlwaysOnTop}" Command="{Binding ToggleAlwaysOnTopCommand}" />
                        </MenuItem>

                        <MenuItem Header="{Binding MenuHelp, Source={x:Static loc:Strings.Instance}}">
                            <MenuItem Header="{Binding MenuKeyboardShortcuts, Source={x:Static loc:Strings.Instance}}" Command="{Binding ShowShortcutsCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding MenuAbout, Source={x:Static loc:Strings.Instance}}" Command="{Binding AboutCommand}" />
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton" Style="{StaticResource Bx.CaptionButton}"
                            Content="&#xE921;" Click="OnMinimize" ToolTip="{Binding TipMinimize, Source={x:Static loc:Strings.Instance}}" />
                    <Button x:Name="MaxButton" Style="{StaticResource Bx.CaptionButton}"
                            Content="&#xE922;" Click="OnMaximizeRestore" ToolTip="{Binding TipMaximize, Source={x:Static loc:Strings.Instance}}" />
                    <Button x:Name="CloseButton" Style="{StaticResource Bx.CloseButton}"
                            Content="&#xE8BB;" Click="OnClose" ToolTip="{Binding TipClose, Source={x:Static loc:Strings.Instance}}" />
                </StackPanel>
            </Grid>

            <!-- ============ Body ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="240" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar expand button (visible when sidebar collapsed) -->
                <Button x:Name="SidebarExpandBtn" Grid.Column="0" Visibility="Collapsed"
                        Style="{StaticResource Bx.CircleButton}" Width="22" Height="22"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        ToolTip="{Binding TipShowSidebar, Source={x:Static loc:Strings.Instance}}"
                        Command="{Binding ToggleSidebarCommand}">
                    <ctl:TablerIcon Icon="chevron-right" Width="12" Height="12"
                                    Stroke="{DynamicResource Bx.Muted}" />
                </Button>

                <!-- Sidebar: Outline / Search only (no file tree in embedded note mode) -->
                <Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource Bx.Sidebar}"
                        BorderBrush="{DynamicResource Bx.Border}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="4,6,4,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Bx.IconButton}" Padding="4"
                                    Command="{Binding ToggleSidebarCommand}" ToolTip="{Binding TipToggleSidebar, Source={x:Static loc:Strings.Instance}}">
                                <ctl:TablerIcon Icon="menu-2" Width="16" Height="16"
                                                Stroke="{DynamicResource Bx.Muted}" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabOutline" Content="{Binding SidebarOutline, Source={x:Static loc:Strings.Instance}}" IsChecked="True"
                                             Style="{StaticResource Bx.TabRadio}" Checked="OnSidebarTabChanged" />
                                <RadioButton x:Name="TabSearch" Content="{Binding SidebarSearch, Source={x:Static loc:Strings.Instance}}"
                                             Style="{StaticResource Bx.TabRadio}" Checked="OnSidebarTabChanged" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <!-- Outline panel -->
                            <Grid x:Name="PanelOutline">
                                <ListBox ItemsSource="{Binding Outline}" BorderThickness="0" Background="Transparent"
                                         SelectionChanged="OnOutlineSelected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Bx.Text}"
                                                       Margin="{Binding Level, Converter={StaticResource OutlineMargin}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <!-- Search panel (roots at the notes folder) -->
                            <Grid x:Name="PanelSearch" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="10,8,10,6">
                                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding TipSearchBox, Source={x:Static loc:Strings.Instance}}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding RunFolderSearchCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right" Content="{Binding SearchBtn, Source={x:Static loc:Strings.Instance}}"
                                                    Command="{Binding RunFolderSearchCommand}" Padding="14,4" />
                                            <CheckBox Content="{Binding SearchRegex, Source={x:Static loc:Strings.Instance}}"
                                                      IsChecked="{Binding SearchUseRegex}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" BorderThickness="0"
                                             Background="Transparent" SelectionChanged="OnSearchResultSelected">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,3">
                                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Bx.Accent}" />
                                                    <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Bx.Muted}" FontSize="11" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource Bx.Border}" ResizeBehavior="PreviousAndNext"
                              DragCompleted="OnSplitterDragCompleted" />

                <wv2:WebView2 x:Name="Web" Grid.Column="2" />
            </Grid>

            <!-- ============ Status bar ============ -->
            <Border x:Name="StatusBar" Grid.Row="2" Height="26" Background="{DynamicResource Bx.Chrome}"
                    BorderBrush="{DynamicResource Bx.Border}" BorderThickness="0,1,0,0"
                    Visibility="{Binding StatusBarVisible, Converter={StaticResource BoolVis}}">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource Bx.Muted}" FontSize="12">
                            <Run Text="{Binding Words, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StatusWords, Source={x:Static loc:Strings.Instance}, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding Chars, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StatusChars, Source={x:Static loc:Strings.Instance}, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding Lines, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StatusLines, Source={x:Static loc:Strings.Instance}, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource Bx.Accent}" FontSize="12" Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelWords}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="[" /><Run Text="{Binding SelWords, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StatusSel, Source={x:Static loc:Strings.Instance}, Mode=OneWay}" /><Run Text="]" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusSource, Source={x:Static loc:Strings.Instance}}" Foreground="{DynamicResource Bx.Accent}" FontSize="12"
                                   Margin="0,0,12,0"
                                   Visibility="{Binding SourceMode, Converter={StaticResource BoolVis}}" />
                        <TextBlock Foreground="{DynamicResource Bx.Muted}" FontSize="12">
                            <Run Text="~" /><Run Text="{Binding ReadingMinutes, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StatusMinRead, Source={x:Static loc:Strings.Instance}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
