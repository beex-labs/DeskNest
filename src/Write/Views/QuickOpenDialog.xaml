<Window x:Class="BeexWrite.Views.QuickOpenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BeexWrite.Localization"
        Title="{Binding QuickOpenTitle, Source={x:Static loc:Strings.Instance}}"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{DynamicResource Bx.WindowBackground}"
        Foreground="{DynamicResource Bx.Text}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="FilterBox" Grid.Row="0" Padding="8,6" FontSize="14"
                 TextChanged="OnFilterChanged" PreviewKeyDown="OnFilterKeyDown" />
        <ListBox x:Name="ResultsList" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0"
                 Background="Transparent" MouseDoubleClick="OnResultDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RelativePath}" Foreground="{DynamicResource Bx.Muted}" FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
