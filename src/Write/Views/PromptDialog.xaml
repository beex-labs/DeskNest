<Window x:Class="BeexWrite.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BeexWrite.Localization"
        Title="BeexWrite"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Bx.WindowBackground}"
        Foreground="{DynamicResource Bx.Text}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Text="Enter a value" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" Padding="6,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{Binding BtnCancel, Source={x:Static loc:Strings.Instance}}" Width="80" IsCancel="True" Padding="6" Margin="0,0,8,0" />
            <Button Content="{Binding BtnOk, Source={x:Static loc:Strings.Instance}}" Width="80" IsDefault="True" Padding="6" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
