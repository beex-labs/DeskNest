<Window x:Class="BeexWrite.Views.InsertTableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BeexWrite.Localization"
        Title="{Binding InsertTableTitle, Source={x:Static loc:Strings.Instance}}"
        Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Bx.WindowBackground}"
        Foreground="{DynamicResource Bx.Text}">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding InsertTableRows, Source={x:Static loc:Strings.Instance}}" Margin="0,0,0,4" />
        <TextBox x:Name="RowsBox" Text="3" Padding="6,4" />
        <TextBlock Text="{Binding InsertTableColumns, Source={x:Static loc:Strings.Instance}}" Margin="0,12,0,4" />
        <TextBox x:Name="ColsBox" Text="3" Padding="6,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding BtnCancel, Source={x:Static loc:Strings.Instance}}" Width="80" IsCancel="True" Padding="6" Margin="0,0,8,0" />
            <Button Content="{Binding BtnInsert, Source={x:Static loc:Strings.Instance}}" Width="80" IsDefault="True" Padding="6" Click="OnInsert" />
        </StackPanel>
    </StackPanel>
</Window>
