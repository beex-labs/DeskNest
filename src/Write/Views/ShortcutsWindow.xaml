<Window x:Class="BeexWrite.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BeexWrite.Localization"
        Title="{Binding ShortcutsTitle, Source={x:Static loc:Strings.Instance}}" Width="500" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bx.WindowBackground}"
        Foreground="{DynamicResource Bx.Text}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding ShortcutsTitle, Source={x:Static loc:Strings.Instance}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <ListView x:Name="ShortcutList" Grid.Row="1" BorderThickness="0"
                  Background="Transparent"
                  Foreground="{DynamicResource Bx.Text}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="0">
            <ListView.Resources>
                <!-- GridView column header style -->
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Bx.Chrome}" />
                    <Setter Property="Foreground" Value="{DynamicResource Bx.Muted}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Bx.Border}" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{DynamicResource Bx.Text}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd" Background="Transparent" Padding="4,4" SnapsToDevicePixels="True">
                                    <GridViewRowPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bx.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bx.Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{Binding ShortcutsColCommand, Source={x:Static loc:Strings.Instance}}" Width="220" DisplayMemberBinding="{Binding Command}" />
                    <GridViewColumn Header="{Binding ShortcutsColShortcut, Source={x:Static loc:Strings.Instance}}" Width="220" DisplayMemberBinding="{Binding Key}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding ShortcutsEditHint, Source={x:Static loc:Strings.Instance}}"
                       Foreground="{DynamicResource Bx.Muted}" FontSize="11" />
            <Button Content="{Binding BtnClose, Source={x:Static loc:Strings.Instance}}" HorizontalAlignment="Right" Padding="20,6"
                    Margin="0,10,0,0" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
