<Window x:Class="BeexWrite.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BeexWrite.Localization"
        Title="{Binding PreferencesTitle, Source={x:Static loc:Strings.Instance}}" Width="560" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Bx.WindowBackground}"
        Foreground="{DynamicResource Bx.Text}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Background="Transparent" BorderThickness="0">
            <!-- General -->
            <TabItem Header="{Binding PrefGeneral, Source={x:Static loc:Strings.Instance}}">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="{Binding PrefLanguage, Source={x:Static loc:Strings.Instance}}" VerticalAlignment="Center" Width="100" />
                        <ComboBox x:Name="LanguageCombo" Width="160">
                            <ComboBoxItem Content="{Binding PrefLangFollowSystem, Source={x:Static loc:Strings.Instance}}" Tag="system" />
                            <ComboBoxItem Content="{Binding PrefLangEn, Source={x:Static loc:Strings.Instance}}" Tag="en" />
                            <ComboBoxItem Content="{Binding PrefLangZhCN, Source={x:Static loc:Strings.Instance}}" Tag="zh-CN" />
                            <ComboBoxItem Content="{Binding PrefLangZhTW, Source={x:Static loc:Strings.Instance}}" Tag="zh-TW" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="AutoSaveCheck" Content="{Binding PrefAutoSave, Source={x:Static loc:Strings.Instance}}" Margin="0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="{Binding PrefAutoSaveInterval, Source={x:Static loc:Strings.Instance}}" VerticalAlignment="Center" />
                        <TextBox x:Name="AutoSaveInterval" Width="60" Margin="8,0" Padding="4" />
                    </StackPanel>
                    <CheckBox x:Name="SidebarCheck" Content="{Binding PrefShowSidebar, Source={x:Static loc:Strings.Instance}}" Margin="0,12" />
                    <CheckBox x:Name="StatusBarCheck" Content="{Binding PrefShowStatusBar, Source={x:Static loc:Strings.Instance}}" Margin="0,4" />
                </StackPanel>
            </TabItem>
            <!-- Appearance -->
            <TabItem Header="{Binding PrefAppearance, Source={x:Static loc:Strings.Instance}}">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="{Binding PrefTheme, Source={x:Static loc:Strings.Instance}}" VerticalAlignment="Center" Width="100" />
                        <ComboBox x:Name="ThemeCombo" Width="160">
                            <ComboBoxItem Content="{Binding MenuFollowSystem, Source={x:Static loc:Strings.Instance}}" Tag="system" />
                            <ComboBoxItem Content="{Binding MenuLight, Source={x:Static loc:Strings.Instance}}" Tag="light" />
                            <ComboBoxItem Content="{Binding MenuDark, Source={x:Static loc:Strings.Instance}}" Tag="dark" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12">
                        <TextBlock Text="{Binding PrefEditorWidth, Source={x:Static loc:Strings.Instance}}" VerticalAlignment="Center" Width="100" />
                        <TextBox x:Name="EditorWidthBox" Width="80" Padding="4" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <!-- Editor -->
            <TabItem Header="{Binding PrefEditor, Source={x:Static loc:Strings.Instance}}">
                <StackPanel Margin="12">
                    <CheckBox x:Name="SourceModeCheck" Content="{Binding PrefSourceMode, Source={x:Static loc:Strings.Instance}}" Margin="0,8" />
                    <CheckBox x:Name="FocusModeCheck" Content="{Binding PrefFocusMode, Source={x:Static loc:Strings.Instance}}" Margin="0,4" />
                    <CheckBox x:Name="TypewriterCheck" Content="{Binding PrefTypewriterMode, Source={x:Static loc:Strings.Instance}}" Margin="0,4" />
                </StackPanel>
            </TabItem>
            <!-- Export -->
            <TabItem Header="{Binding PrefExport, Source={x:Static loc:Strings.Instance}}">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="{Binding PrefPaperSize, Source={x:Static loc:Strings.Instance}}" VerticalAlignment="Center" Width="120" />
                        <ComboBox x:Name="PaperSizeCombo" Width="120">
                            <ComboBoxItem Content="A4" Tag="a4" />
                            <ComboBoxItem Content="Letter" Tag="letter" />
                            <ComboBoxItem Content="A3" Tag="a3" />
                            <ComboBoxItem Content="A5" Tag="a5" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="{Binding PrefMargin, Source={x:Static loc:Strings.Instance}}" VerticalAlignment="Center" Width="120" />
                        <TextBox x:Name="MarginBox" Width="80" />
                    </StackPanel>
                    <CheckBox x:Name="BookmarksCheck" Content="{Binding PrefBookmarks, Source={x:Static loc:Strings.Instance}}" Margin="0,8" />
                    <TextBlock TextWrapping="Wrap" Margin="0,16"
                               Foreground="{DynamicResource Bx.Muted}" FontSize="11"
                               Text="{Binding PrefExportNote, Source={x:Static loc:Strings.Instance}}" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding BtnCancel, Source={x:Static loc:Strings.Instance}}" Width="90" IsCancel="True" Padding="6" Margin="0,0,8,0" />
            <Button Content="{Binding BtnSave, Source={x:Static loc:Strings.Instance}}" Width="90" IsDefault="True" Padding="6" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
